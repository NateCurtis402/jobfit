# Copy to .env and edit. Dev-only values; nothing here is a real credential.
POSTGRES_PASSWORD=jobfit_dev_only
DATABASE_URL=postgresql://jobfit:jobfit_dev_only@127.0.0.1:5432/jobfit

# Local embeddings via Ollama (free, no API key, runs on the GPU).
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# Local model used by the /ask agent (needs native tool-calling support).
AGENT_MODEL=llama3.1:8b

# Optional: Omaha/metro job coverage. Free key from developer.adzuna.com.
# Leave blank and JobFit keeps working on the keyless remote feeds.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
