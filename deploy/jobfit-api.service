[Unit]
Description=JobFit API (portfolio project) — FastAPI over the posting index
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/nero/projects/jobfit
# Bring the database up first; idempotent, so it is safe on every start.
ExecStartPre=/usr/bin/docker compose up -d db
ExecStart=/home/nero/projects/jobfit/.venv/bin/uvicorn jobfit.api:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
